# Copie para .env e preencha. O .env NUNCA é versionado.

# ── Banco de dados ──────────────────────────────────────────────────────────
POSTGRES_USER=radar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=radar

# ── n8n ──────────────────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# ── Auth API ──────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres — gere com: openssl rand -hex 32
JWT_SECRET=

# ── URLs (produção: substitua SEU_DOMINIO) ────────────────────────────────────
# Em dev local mantenha localhost
CORS_ORIGIN=http://localhost:4200
FRONTEND_URL=http://localhost:4200
API_BASE_URL=http://localhost:3001

# Segredo interno entre serviços — gere com: openssl rand -hex 32
INTERNAL_SECRET=

# ── E-mail (Resend.com) ───────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=noreply@SEU_DOMINIO

# ── OAuth Google (opcional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Telegram — alertas (opcional) ────────────────────────────────────────────
# Crie o bot com @BotFather e obtenha o chat_id em:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── IA ────────────────────────────────────────────────────────────────────────
# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
