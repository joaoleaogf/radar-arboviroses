# Copie para .env e preencha. O .env NUNCA é versionado.

# Postgres (usado pelo PostGIS e pelo próprio n8n)
POSTGRES_USER=radar
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=radar

# Chave de criptografia das credenciais do n8n (gere com: openssl rand -hex 24)
N8N_ENCRYPTION_KEY=

# Origem liberada no CORS dos webhooks (URL do dashboard)
CORS_ORIGIN=http://localhost:4200

# Telegram — crie o bot com o @BotFather (/newbot)
# Chat ID dos alertas: mande uma mensagem ao bot e veja em https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Gemini (free tier) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
