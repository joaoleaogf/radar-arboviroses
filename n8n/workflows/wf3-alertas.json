{
  "id": "radarwf3",
  "name": "WF3 - Alertas Telegram",
  "active": true,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "wf3-cron",
      "name": "Toda terça 09h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "cronExpression", "expression": "0 9 * * 2" }
          ]
        }
      }
    },
    {
      "id": "wf3-manual",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "wf3-pg-novos",
      "name": "Municípios em alerta (novos)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [240, 100],
      "credentials": {
        "postgres": { "id": "radarpg01", "name": "Radar Postgres" }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.geocode, s.nome, s.doenca, s.se, s.nivel, s.casos_est, s.rt\nFROM situacao_atual s\nWHERE s.nivel >= 3\n  AND NOT EXISTS (\n    SELECT 1 FROM alerta_enviado a\n    WHERE a.geocode = s.geocode AND a.doenca = s.doenca AND a.se = s.se\n  )\nORDER BY s.nivel DESC, s.casos_est DESC NULLS LAST;",
        "options": {}
      }
    },
    {
      "id": "wf3-code-msg",
      "name": "Formatar mensagem",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 100],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const niveis = { 3: '🟠 Laranja', 4: '🔴 Vermelho' };\nconst d = $json.doenca === 'chikungunya' ? 'Chikungunya' : 'Dengue';\nconst se = String($json.se);\nconst ano = se.slice(0, 4);\nconst sem = se.slice(4);\nconst casos = $json.casos_est != null ? Math.round($json.casos_est) : '—';\nconst rt = $json.rt != null ? Number($json.rt).toFixed(2) : '—';\n$json.mensagem = `🦟 *Alerta de ${d}*\\n\\n*${$json.nome}* entrou em nível ${niveis[$json.nivel] || $json.nivel}.\\n\\n• Semana epidemiológica: ${sem}/${ano}\\n• Casos estimados: ${casos}\\n• Rt (transmissão): ${rt}\\n\\n_Fonte: InfoDengue (Fiocruz/FGV)_`;\nreturn $json;"
      }
    },
    {
      "id": "wf3-telegram",
      "name": "Enviar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [720, 100],
      "credentials": {
        "telegramApi": { "id": "radartg01", "name": "Radar Telegram Bot" }
      },
      "parameters": {
        "chatId": "={{ $env.TELEGRAM_ALERT_CHAT_ID }}",
        "text": "={{ $json.mensagem }}",
        "additionalFields": { "parse_mode": "Markdown" }
      }
    },
    {
      "id": "wf3-pg-marcar",
      "name": "Marcar como enviado",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [960, 100],
      "credentials": {
        "postgres": { "id": "radarpg01", "name": "Radar Postgres" }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO alerta_enviado (geocode, doenca, se, nivel)\nVALUES ($1, $2, $3, $4)\nON CONFLICT (geocode, doenca, se) DO NOTHING;",
        "options": {
          "queryReplacement": "={{ $json.geocode }},{{ $json.doenca }},{{ $json.se }},{{ $json.nivel }}"
        }
      }
    }
  ],
  "connections": {
    "Toda terça 09h": {
      "main": [[{ "node": "Municípios em alerta (novos)", "type": "main", "index": 0 }]]
    },
    "Executar manualmente": {
      "main": [[{ "node": "Municípios em alerta (novos)", "type": "main", "index": 0 }]]
    },
    "Municípios em alerta (novos)": {
      "main": [[{ "node": "Formatar mensagem", "type": "main", "index": 0 }]]
    },
    "Formatar mensagem": {
      "main": [[{ "node": "Enviar Telegram", "type": "main", "index": 0 }]]
    },
    "Enviar Telegram": {
      "main": [[{ "node": "Marcar como enviado", "type": "main", "index": 0 }]]
    }
  }
}
