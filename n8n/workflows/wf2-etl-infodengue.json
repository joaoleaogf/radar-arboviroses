{
  "id": "radarwf2",
  "name": "WF2 - ETL InfoDengue",
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "id": "wf2-manual",
      "name": "Executar manualmente",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "wf2-cron",
      "name": "Toda terça 08h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 2"
            }
          ]
        }
      }
    },
    {
      "id": "wf2-pg-run",
      "name": "Registrar execução",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        240,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "radarpg01",
          "name": "Radar Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO etl_run (workflow) VALUES ('etl-infodengue') RETURNING id;",
        "options": {}
      }
    },
    {
      "id": "wf2-pg-munis",
      "name": "Buscar municípios",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        100
      ],
      "credentials": {
        "postgres": {
          "id": "radarpg01",
          "name": "Radar Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT geocode FROM municipio ORDER BY geocode;",
        "options": {}
      }
    },
    {
      "id": "wf2-code-reqs",
      "name": "Montar requisições",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Janela fixa desde 2024: o upsert é idempotente, então toda execução\n// também corrige retroativamente revisões do modelo InfoDengue.\nconst eyEnd = new Date().getFullYear();\nconst reqs = [];\nfor (const item of items) {\n  for (const doenca of ['dengue', 'chikungunya']) {\n    reqs.push({ json: { geocode: item.json.geocode, doenca, eyStart: 2024, eyEnd } });\n  }\n}\nreturn reqs;"
      }
    },
    {
      "id": "wf2-lotes",
      "name": "Lotes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        960,
        100
      ],
      "parameters": {
        "batchSize": 1,
        "options": {}
      }
    },
    {
      "id": "wf2-http",
      "name": "InfoDengue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "url": "=https://info.dengue.mat.br/api/alertcity?geocode={{ $json.geocode }}&disease={{ $json.doenca }}&format=json&ew_start=1&ew_end=53&ey_start={{ $json.eyStart }}&ey_end={{ $json.eyEnd }}",
        "options": {
          "timeout": 30000,
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1000
            }
          }
        }
      }
    },
    {
      "id": "wf2-code-norm",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        200
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// batchSize = 1 no nó Lotes: todos os itens (semanas) deste lote pertencem\n// ao mesmo município × doença, lido direto do lote atual (sem pairedItem).\nconst src = $('Lotes').first().json;\nconst rows = [];\nfor (const it of items) {\n  const j = it.json;\n  if (!j || j.SE === undefined || j.SE === null) continue;\n  rows.push({\n    geocode: src.geocode,\n    doenca: src.doenca,\n    se: j.SE,\n    data_inise: new Date(j.data_iniSE).toISOString().slice(0, 10),\n    casos: j.casos ?? null,\n    casos_est: j.casos_est ?? null,\n    nivel: j.nivel ?? null,\n    rt: j.Rt ?? null,\n    p_inc100k: j.p_inc100k ?? null,\n    tempmed: j.tempmed != null ? Number(j.tempmed) : null,\n    umidmed: j.umidmed != null ? Number(j.umidmed) : null,\n    notif_accum_year: j.notif_accum_year ?? null,\n    pop: j.pop != null ? parseInt(j.pop, 10) : null,\n  });\n}\nconst pops = [...new Map(rows.filter((r) => r.pop).map((r) => [r.geocode, r.pop])).entries()].map(\n  ([geocode, pop]) => ({ geocode, pop })\n);\nreturn [{ json: { rows: JSON.stringify(rows), pops: JSON.stringify(pops), count: rows.length } }];"
      }
    },
    {
      "id": "wf2-pg-casos",
      "name": "Gravar casos",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1680,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "radarpg01",
          "name": "Radar Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO caso_semana (geocode, doenca, se, data_inise, casos, casos_est, nivel, rt, p_inc100k, tempmed, umidmed, notif_accum_year, updated_at)\nSELECT (r->>'geocode')::bigint, r->>'doenca', (r->>'se')::int, (r->>'data_inise')::date,\n       (r->>'casos')::int, (r->>'casos_est')::numeric, (r->>'nivel')::smallint,\n       (r->>'rt')::numeric, (r->>'p_inc100k')::numeric, (r->>'tempmed')::numeric,\n       (r->>'umidmed')::numeric, (r->>'notif_accum_year')::int, now()\nFROM jsonb_array_elements($1::jsonb) r\nON CONFLICT (geocode, doenca, se) DO UPDATE\nSET casos = EXCLUDED.casos, casos_est = EXCLUDED.casos_est, nivel = EXCLUDED.nivel,\n    rt = EXCLUDED.rt, p_inc100k = EXCLUDED.p_inc100k, tempmed = EXCLUDED.tempmed,\n    umidmed = EXCLUDED.umidmed, notif_accum_year = EXCLUDED.notif_accum_year, updated_at = now();",
        "options": {
          "queryReplacement": "={{ $json.rows }}"
        }
      }
    },
    {
      "id": "wf2-pg-pop",
      "name": "Atualizar população",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1920,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "radarpg01",
          "name": "Radar Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE municipio m SET pop = (p->>'pop')::int\nFROM jsonb_array_elements($1::jsonb) p\nWHERE m.geocode = (p->>'geocode')::bigint;",
        "options": {
          "queryReplacement": "={{ $('Normalizar').first().json.pops }}"
        }
      }
    },
    {
      "id": "wf2-pg-fim",
      "name": "Finalizar execução",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1200,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "radarpg01",
          "name": "Radar Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE etl_run\nSET finished = now(), status = 'success',\n    registros = (SELECT count(*) FROM caso_semana)\nWHERE id = $1;",
        "options": {
          "queryReplacement": "={{ $('Registrar execução').first().json.id }}"
        }
      }
    },
    {
      "id": "wf2-refresh-matview",
      "name": "Refresh situacao_atual",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1400,
        0
      ],
      "credentials": {
        "postgres": {
          "id": "radarpg01",
          "name": "Radar Postgres"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "REFRESH MATERIALIZED VIEW situacao_atual;",
        "options": {}
      }
    }
  ],
